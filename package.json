{
  "name": "open-webui-browser-extension",
  "version": "0.2.0",
  "private": true,
  "description": "A privacy-first cross-browser extension for Open WebUI.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "npm run clean && npm run build:chromium && npm run build:firefox && npm run verify:build",
    "verify:build": "node scripts/verify-build.mjs",
    "build:chromium": "vite build --mode chromium",
    "build:firefox": "vite build --mode firefox",
    "clean": "rm -rf dist",
    "dev": "vite --mode chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.45.6",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.3.0",
    "@types/webextension-polyfill": "^0.12.3",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-svelte": "^3.23.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
